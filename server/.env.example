# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000

# MongoDB Atlas connection string (get it from Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/placement_board?retryWrites=true&w=majority

# Any long random text. Used to sign login tokens (JWT).
JWT_SECRET=replace_this_with_a_long_random_text

# URL of the React frontend (used for CORS). Use several URLs separated by commas.
CLIENT_URL=http://localhost:5173

# A secret code that is required when someone registers as an ADMIN
ADMIN_SECRET=replace_with_a_private_admin_code

# Used only by the seed script (npm run seed) to create the first admin
ADMIN_NAME=Placement Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
